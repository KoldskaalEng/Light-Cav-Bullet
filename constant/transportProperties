FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (water vapour);

// phaseChangeTwoPhaseMixture SchnerrSauer; // Not needed only one model

pSat            2300;   // Saturation pressure

sigma           0.07;

water
{
    transportModel  Newtonian;
    nu              9e-07;
    rho             1000;
}

vapour
{
    transportModel  Newtonian;
    nu              4.273e-04;
    rho             0.02308;
}

cavitationCoeffs // no need to specify model -> only one model. 
{
    pSat            2300;
    rMin            1e-6;
    rMax            1e-4;
    lambda          2;
    nBins           5;
    rNuc            0;
}



