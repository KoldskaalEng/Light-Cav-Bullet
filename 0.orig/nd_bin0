FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nd_bin0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
    }

    bullet
    {
        type            fixedValue;
        value           uniform 1000;
    }

    walls
    {
        type            symmetry;
    }

    "procBoundary.*"
    {
        type            processor;
        value             $internalField; 
    }
}


